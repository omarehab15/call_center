LIVEKIT_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_AGENT_NAME=

# STT — Deepgram Nova-3 (Saudi Arabic)
STT_MODEL=nova-3
STT_LANGUAGE=ar-SA
DEEPGRAM_API_KEY=your_deepgram_key_here

# LLM backend
LLAMA_BASE_URL=http://localhost:11436/v1
LLAMA_MODEL=allam-7b
GROQ_LLM_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=gsk_your_key_here

# TTS — Cartesia Sonic 3.5
CARTESIA_MODEL=sonic-3.5
CARTESIA_VOICE_ID=your_cartesia_voice_id_here
CARTESIA_LANGUAGE=ar
CARTESIA_API_KEY=your_cartesia_key_here
AGENT_NOISE_CANCELLATION=off

# SIP Telephony (LiveKit SIP)
SIP_PROVIDER_NUMBER=+15551234567
SIP_OUTBOUND_HOST=sip.provider.com
SIP_DESTINATION_COUNTRY=US
SIP_AUTH_USERNAME=your_sip_username
SIP_AUTH_PASSWORD=your_sip_password
SIP_ROOM_NAME=agent-room
SIP_CALL_TO=+15559876543
SIP_WAIT_UNTIL_ANSWERED=true
SIP_INBOUND_TRUNK_NAME=my-inbound-trunk
SIP_OUTBOUND_TRUNK_NAME=my-outbound-trunk
SIP_DISPATCH_RULE_NAME=route-to-agent-room

# SIP service runtime (self-hosted)
SIP_PUBLIC_HOST=sip.your-domain.com
SIP_ENABLED=false
SIP_SIGNALING_PORT=5060
SIP_TLS_PORT=5061
SIP_RTP_PORT_START=10000
SIP_RTP_PORT_END=20000
SIP_USE_EXTERNAL_IP=true
SIP_MEDIA_USE_EXTERNAL_IP=true
SIP_SYMMETRIC_RTP=true
SIP_IGNORE_LOCAL_ADDR_IN_SDP=true
SIP_ENABLE_JITTER_BUFFER=true
SIP_LOG_LEVEL=info

# Vast-friendly SIP test overlay (docker-compose.local.vast-sip.yml)
SIP_TEST_RTP_PORT_START=12000
SIP_TEST_RTP_PORT_END=12031
