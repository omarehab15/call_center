# Deprecated example for an older monolithic setup.
# Use .env.local.example for the current docker-compose.local.yml workflow.

LIVEKIT_URL=ws://livekit:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ── STT (Whisper via VoxBox — local) ──────────────────────────────────────────
STT_PROVIDER=whisper
STT_MODEL=dev-ahmedhany/whisper-large-v3-arabic-ft-v3-ct2-int8
VOXBOX_HF_REPO_ID=dev-ahmedhany/whisper-large-v3-arabic-ft-v3-ct2-int8

# ── LLM (Groq — cloud) ────────────────────────────────────────────────────────
# Available models: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# ── Intent Classifier (Groq — cloud) ─────────────────────────────────────────
# يقرر إذا كان سؤال العميل يحتاج RAG أم لا — بدائل: llama-3.3-70b-versatile أو "" لتعطيله
INTENT_CLASSIFIER_MODEL=llama-3.1-8b-instant

# ── TTS (Groq Orpheus — cloud) ────────────────────────────────────────────────
TTS_VOICE=fahad

# ── Groq API Key (shared by LLM + TTS) ───────────────────────────────────────
GROQ_API_KEY=gsk_your_key_here

# ── SIP Telephony (LiveKit SIP) ───────────────────────────────────────────────
# Set these only when you want inbound/outbound PSTN calling.
SIP_PROVIDER_NUMBER=+15551234567
SIP_OUTBOUND_HOST=sip.provider.com
SIP_DESTINATION_COUNTRY=US
SIP_AUTH_USERNAME=your_sip_username
SIP_AUTH_PASSWORD=your_sip_password
SIP_ROOM_NAME=agent-room
SIP_CALL_TO=+15559876543
SIP_WAIT_UNTIL_ANSWERED=true
SIP_INBOUND_TRUNK_NAME=my-inbound-trunk
SIP_OUTBOUND_TRUNK_NAME=my-outbound-trunk
SIP_DISPATCH_RULE_NAME=route-to-agent-room

# SIP service runtime (self-hosted)
# Public DNS/IP that your SIP provider can reach.
SIP_PUBLIC_HOST=sip.your-domain.com
# Start SIP service when using the local start script.
SIP_ENABLED=false
# SIP transport ports exposed by docker-compose local profile.
SIP_SIGNALING_PORT=5060
SIP_TLS_PORT=5061
SIP_RTP_PORT_START=10000
SIP_RTP_PORT_END=20000
SIP_USE_EXTERNAL_IP=true
SIP_LOG_LEVEL=info

# Vast-friendly SIP test overlay (docker-compose.local.vast-sip.yml)
# Smaller RTP window to fit limited public port budgets (testing only).
SIP_TEST_RTP_PORT_START=12000
SIP_TEST_RTP_PORT_END=12031
