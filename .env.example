# .env — Used by docker-compose.yml (monolithic single-machine deployment)
# Copy .env.example to .env and fill in your Groq API key

LIVEKIT_URL=ws://livekit:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ── STT (Whisper via VoxBox) ───────────────────────────────────────────────────
STT_PROVIDER=whisper
STT_MODEL=dev-ahmedhany/whisper-large-v3-arabic-ft-v3-ct2-int8
VOXBOX_HF_REPO_ID=dev-ahmedhany/whisper-large-v3-arabic-ft-v3-ct2-int8

# ── LLM (llama.cpp) ───────────────────────────────────────────────────────────
LLAMA_HF_REPO=bartowski/ALLaM-AI_ALLaM-7B-Instruct-preview-GGUF
LLAMA_HF_FILE=ALLaM-AI_ALLaM-7B-Instruct-preview-Q6_K_L.gguf
LLAMA_MODEL_ALIAS=allam-7b
LLAMA_MODEL=allam-7b
LLAMA_HOST_PORT=11436
LLAMA_CTX_SIZE=8192

# ── TTS (Groq Orpheus — cloud) ────────────────────────────────────────────────
TTS_VOICE=fahad
GROQ_API_KEY=gsk_your_key_here
