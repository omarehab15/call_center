# .env — Used by docker-compose.yml (monolithic single-machine deployment)
# Copy .env.example to .env and fill in your Groq API key

LIVEKIT_URL=ws://livekit:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ── STT (Whisper via VoxBox — local) ──────────────────────────────────────────
STT_PROVIDER=whisper
STT_MODEL=dev-ahmedhany/whisper-large-v3-arabic-ft-v3-ct2-int8
VOXBOX_HF_REPO_ID=dev-ahmedhany/whisper-large-v3-arabic-ft-v3-ct2-int8

# ── LLM (Groq — cloud) ────────────────────────────────────────────────────────
# Available models: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# ── Groq API Key (LLM only — TTS is now local Habibi-TTS) ────────────────────
GROQ_API_KEY=gsk_your_key_here

# ── TTS (Habibi-TTS — local) ──────────────────────────────────────────────────
# TTS_VOICE = Habibi dialect ID used as the voice parameter
# Options: MSA SAU UAE ALG IRQ EGY MAR OMN TUN LEV SDN LBY
TTS_VOICE=SAU
# Internal URL of the Habibi-TTS container (set automatically by docker-compose)
HABIBI_TTS_BASE_URL=http://habibi_tts:8000/v1
# Optional: dialect override inside the Habibi-TTS container itself
HABIBI_DIALECT=SAU
