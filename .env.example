# .env — Used by docker-compose.yml (monolithic single-machine deployment)

LIVEKIT_URL=ws://livekit:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ── STT (Whisper via VoxBox — local) ──────────────────────────────────────────
STT_PROVIDER=whisper
STT_MODEL=dev-ahmedhany/whisper-large-v3-arabic-ft-v3-ct2-int8
VOXBOX_HF_REPO_ID=dev-ahmedhany/whisper-large-v3-arabic-ft-v3-ct2-int8

# ── LLM (Groq — cloud) ────────────────────────────────────────────────────────
# Available models: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=gsk_your_key_here

# ── TTS (habibi-tts — local GPU) ──────────────────────────────────────────────
# HABIBI_MODEL options: Unified (recommended) | SAU | EGY | MSA | IRQ | ALG | MAR
HABIBI_MODEL=Unified
# HABIBI_VOICE = filename (no extension) inside inference/habibi/assets/
# Drop your <voice>.wav + <voice>.txt there to define a custom voice
HABIBI_VOICE=SAU_male_1
# NFE steps: 16 = faster, 32 = better quality
HABIBI_NFE=16
