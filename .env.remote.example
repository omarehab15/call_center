# .env.remote.example — Copy to .env.remote (usually no changes needed)
# Used with: docker compose -f docker-compose.remote.yml -f docker-compose.remote-gpu.yml --env-file .env.remote up

# ── LLM (llama.cpp) ────────────────────────────────────────────────────────────
LLAMA_HF_REPO=unsloth/gemma-4-26B-A4B-it-GGUF
LLAMA_HF_FILE=gemma-4-26B-A4B-it-UD-Q4_K_M.gguf
LLAMA_MODEL_ALIAS=gemma-4-26b
LLAMA_HOST_PORT=11436
LLAMA_CTX_SIZE=16384

# ── STT (Whisper via VoxBox) ───────────────────────────────────────────────────
VOXBOX_HF_REPO_ID=h2oai/faster-whisper-large-v3-turbo

# ── TTS (lahgtna-chatterbox-v1) ────────────────────────────────────────────────
# HuggingFace repo for the Saudi Arabic fine-tune of Chatterbox
LAHGTNA_HF_REPO=oddadmix/lahgtna-chatterbox-v1
LAHGTNA_HOST_PORT=8880
LAHGTNA_DEVICE=cuda

# Generation parameters — tune these for your use case:
#
#  EXAGGERATION  0.0–1.0   Emotional expressiveness. 0.5 is neutral.
#                           Lower (0.3) sounds more professional/calm for call center.
#
#  CFG_WEIGHT    0.0–1.0   Classifier-free guidance strength.
#                           Higher = closer to reference voice, less varied.
#                           0.5 is a good starting point.
#
#  TEMPERATURE   0.0–1.0   Sampling temperature. Lower = more deterministic.
#                           0.7–0.8 works well for Arabic.
#
#  REPETITION_PENALTY      Critical for lahgtna — prevents syllable looping artefacts.
#                           Keep at 1.2–1.3. Do not set below 1.1.
#
LAHGTNA_EXAGGERATION=0.5
LAHGTNA_CFG_WEIGHT=0.5
LAHGTNA_TEMPERATURE=0.8
LAHGTNA_REPETITION_PENALTY=1.75

#  MIN_P   0.0–1.0   Minimum probability threshold for token sampling.
#                     Higher = fewer candidate tokens = slightly faster, less varied.
#                     0.05 is the default. Try 0.1–0.2 for a small speed boost.
#
#  TOP_P   0.0–1.0   Nucleus sampling cutoff. Lower = faster sampling.
#                     1.0 (default) uses all tokens. Try 0.9 for modest speedup.
#
LAHGTNA_MIN_P=0.05
LAHGTNA_TOP_P=1.0

# ── TTS provider selection ──────────────────────────────────────────────────────
# Toggle between "groq" (cloud) and "lahgtna" (self-hosted GPU on vast.ai)
#
#  groq    → canopylabs/orpheus-arabic-saudi via Groq LPU
#            Faster, no GPU needed for TTS, requires GROQ_API_KEY
#            Available voices: abdullah, aisha, fahad, sultan, lulwa, noura
#
#  lahgtna → oddadmix/lahgtna-chatterbox-v1 running in Docker
#            Self-hosted, uses custom voice reference WAVs, no API key
#
TTS_PROVIDER=groq
TTS_VOICE=fahad
