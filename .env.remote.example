# .env.remote.example — Copy to .env.remote (usually no changes needed)
# Used with: docker compose -f docker-compose.remote.yml -f docker-compose.remote-gpu.yml --env-file .env.remote up

# LLM (llama.cpp)
LLAMA_HF_REPO=unsloth/Qwen3-4B-Instruct-2507-GGUF
LLAMA_MODEL_ALIAS=qwen3-4b
LLAMA_HOST_PORT=11436
LLAMA_CTX_SIZE=16384

# STT (Nemotron)
NEMOTRON_MODEL_NAME=nvidia/nemotron-speech-streaming-en-0.6b
NEMOTRON_MODEL_ID=nemotron-speech-streaming

# TTS (Kokoro) — GPU image
KOKORO_IMAGE=ghcr.io/remsky/kokoro-fastapi-gpu:latest
