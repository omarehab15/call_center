LIVEKIT_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# STT backend
STT_PROVIDER=whisper
STT_BASE_URL=http://localhost:11435/v1
STT_MODEL=dev-ahmedhany/whisper-large-v3-arabic-ft-v3-ct2-int8
STT_API_KEY=no-key-needed

# LLM backend (Groq — cloud)
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=gsk_your_key_here

# TTS — Habibi-TTS (local)
# dialect ID used as voice: MSA SAU UAE ALG IRQ EGY MAR OMN TUN LEV SDN LBY
TTS_VOICE=SAU
HABIBI_TTS_BASE_URL=http://localhost:8002/v1
HABIBI_MODEL=Specialized
HABIBI_DIALECT=SAU
