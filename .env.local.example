# .env.local.example — Copy to .env.local and fill in your Tailscale IP
# Used with: docker compose -f docker-compose.local.yml --env-file .env.local up
#
# Replace 100.x.x.x with your vast.ai machine's Tailscale IP

# LiveKit
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Remote model endpoints (via Tailscale)
# STT — Nemotron on remote machine (port 11435)
STT_PROVIDER=nemotron
STT_BASE_URL=http://100.x.x.x:11435/v1
STT_MODEL=nemotron-speech-streaming
STT_API_KEY=no-key-needed

# LLM — llama.cpp on remote machine (port 11436)
LLAMA_BASE_URL=http://100.x.x.x:11436/v1
LLAMA_MODEL=qwen3-4b

# TTS — Kokoro on remote machine (port 8880)
KOKORO_BASE_URL=http://100.x.x.x:8880/v1
