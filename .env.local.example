# .env.local.example
# Canonical env file for docker-compose.local.yml and start-local.sh.
# Copy this file to .env.local, then replace placeholders with real values.

# Local LiveKit server
LIVEKIT_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Optional: set to enable explicit agent dispatch. Leave empty for automatic dispatch.
LIVEKIT_AGENT_NAME=

# Local startup/build behavior
# changed: rebuild app images only when the build context changes.
# always: force rebuild every run.
# missing: build only if image is missing.
# never: skip image build.
BUILD_IMAGES=changed
BUILD_PROGRESS=plain

# STT backend — Deepgram Nova-3 (يدعم اللهجات العربية، منها ar-SA)
STT_MODEL=nova-3
STT_LANGUAGE=ar-SA
# API key من https://console.deepgram.com/
DEEPGRAM_API_KEY=

# LLM backend (Groq cloud)
GROQ_LLM_MODEL=openai/gpt-oss-120b

# TTS backend — Cartesia Sonic 3.5
CARTESIA_MODEL=sonic-3.5
# Voice ID — دور على صوت عربي من https://play.cartesia.ai/voices
# لو سبته فاضي هيستخدم الـ default voice بتاع المكتبة (إنجليزي)
CARTESIA_VOICE_ID=
# لغة التوليد
CARTESIA_LANGUAGE=ar
# API key من https://play.cartesia.ai/keys
CARTESIA_API_KEY=

# Agent-side input noise cancellation.
# Options: off, ai_coustics, quail_vf_l, nc, bvc, bvc_telephony
# For SIP-specific Krisp, prefer SIP trunk krisp_enabled when available.
AGENT_NOISE_CANCELLATION=off

# Groq API key (used for the LLM)
GROQ_API_KEY=
# Call logs
CALL_LOGS=/app/call_logs
CALL_LOGS_HOST=./livekit_agent/call_logs

# Local call recordings (stereo OGG: left channel=caller, right channel=agent)
# Files saved to CALL_RECORDINGS_HOST on the host machine.
CALL_RECORDING_ENABLED=true
CALL_RECORDINGS_HOST=./call_recordings

# ── Background Audio (LiveKit BackgroundAudioPlayer) ──────────────────────────
# شغّل أو أوقف صوت الخلفية بالكامل
BACKGROUND_AUDIO_ENABLED=true
# مستوى صوت المكتب اللي بيشتغل طول المكالمة (0.0 → 1.0)
BACKGROUND_AUDIO_AMBIENT_VOLUME=0.4
# مستوى صوت الكيبورد اللي بيشتغل وقت تفكير الـ agent (0.0 → 1.0)
BACKGROUND_AUDIO_THINKING_VOLUME=0.6

# RAG knowledge base
# Intent Classifier — GLiClass يشتغل in-process جوه الـ agent (بدون Groq API)
# الموديل بيتنزّل تلقائياً من HuggingFace أول مرة بس (~600MB)
INTENT_CLASSIFIER_MODEL=openai/gpt-oss-20b

RAG_ENABLED=true
RAG_CHROMA_PATH=/app/rag/chroma
RAG_CHROMA_PATH_HOST=./rag/chroma
RAG_COLLECTION_NAME=call_center_knowledge_chroma
RAG_EMBEDDING_PROVIDER=chroma
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_BASE_URL=
RAG_EMBEDDING_DEVICE=
RAG_TOP_K=2
# الحد الأقصى لعدد الحروف اللي بتتحط في الـ context (تعديل 4)
RAG_MAX_CONTEXT_CHARS=600
# Chunks أعلى من الـ threshold ده بيتجاهلوا (تعديل 6) — cosine distance: 0=مطابق، 1=بعيد
# ارفعه لـ 0.65 لو أسئلة محتاجة معلومات بتتفلتر، نزّله لـ 0.45 لو الردود فيها معلومات مش ذات صلة
RAG_DISTANCE_THRESHOLD=0.55
RAG_KNOWLEDGE_DIR=/app/knowledge_base
RAG_KNOWLEDGE_DIR_HOST=./livekit_agent/knowledge_base
RAG_INGEST_MODE=always
RAG_INGEST_MARKER=./rag/.last_ingest
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150


# SIP Telephony (LiveKit SIP)
# Use E.164 format for phone numbers, for example +15551234567.
SIP_PROVIDER_NUMBER=
SIP_OUTBOUND_HOST=
SIP_DESTINATION_COUNTRY=EG
SIP_AUTH_USERNAME=
SIP_AUTH_PASSWORD=
SIP_ROOM_NAME=agent-room
SIP_CALL_TO=+15559876543
SIP_WAIT_UNTIL_ANSWERED=true
SIP_INBOUND_TRUNK_NAME=my-inbound-trunk
SIP_OUTBOUND_TRUNK_NAME=my-outbound-trunk
SIP_DISPATCH_RULE_NAME=route-to-agent-room

# SIP service runtime (self-hosted)
# Public DNS/IP that your SIP provider can reach.
SIP_PUBLIC_HOST=
SIP_ENABLED=true
SIP_SIGNALING_PORT=5060
SIP_TLS_PORT=5061
SIP_RTP_PORT_START=10000
# Keep the local Docker Desktop range small. Use 10000-20000 on a Linux/VPS host
# when you need many concurrent SIP calls and can open the full UDP range.
SIP_RTP_PORT_END=10031
SIP_USE_EXTERNAL_IP=true
SIP_MEDIA_USE_EXTERNAL_IP=true
SIP_SYMMETRIC_RTP=true
SIP_IGNORE_LOCAL_ADDR_IN_SDP=true
SIP_ENABLE_JITTER_BUFFER=true
SIP_LOG_LEVEL=info

# Vast-friendly SIP test overlay (docker-compose.local.vast-sip.yml)
# Set SIP_TEST_PROFILE=vast to use the reduced RTP range below.
SIP_TEST_PROFILE=
SIP_TEST_RTP_PORT_START=12000
SIP_TEST_RTP_PORT_END=12031

# Optional frontend sandbox settings; usually empty for local compose.
NEXT_PUBLIC_CONN_DETAILS_ENDPOINT=
NEXT_PUBLIC_APP_CONFIG_ENDPOINT=
SANDBOX_ID=

# Optional Python/RAG logging
LOG_LEVEL=INFO
